ANTHROPIC_API_KEY=your-api-key-here

# Reddit fetching (no API key needed — uses public RSS feeds).
# Optional tuning knobs; sensible defaults are used if unset:
# REDDIT_USER_AGENT=Mozilla/5.0 alpha-ai-newsletter/1.0
# REDDIT_REQUEST_DELAY=5     # seconds between subreddits (raise on throttled IPs)
# REDDIT_MAX_RETRIES=4       # retries on HTTP 429 before giving up
# REDDIT_BACKOFF_SECONDS=10  # initial backoff, doubles each 429 retry
